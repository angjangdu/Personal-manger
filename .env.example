# Personal OS — environment template
# Copy to .env.local and fill in values. Never commit .env.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data source (Phase 21+): "local" (default) or "supabase"
NEXT_PUBLIC_DATA_SOURCE=local

# Supabase — required when NEXT_PUBLIC_DATA_SOURCE=supabase
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-only, never expose to browser

# Whole-store sync guard (Phase 22/23) — same value on both sides
# SYNC_SECRET=
# NEXT_PUBLIC_SYNC_SECRET=
